# Copie para .env (local) e preencha com os valores reais da instituicao.
# O arquivo .env NAO vai para o git (esta no .gitignore).
# No deploy, defina as MESMAS chaves no painel: "Variaveis de ambiente".

# Camada OpenAI-compativel da LLM institucional (sem /v1 - o app acrescenta).
LLM_URL=https://REPLACE-llm-endpoint:PORT
# Modelo servido pela instituicao.
LLM_MODEL=REPLACE-model
# A LLM interna nao exige chave real; qualquer valor nao vazio basta.
LLM_API_KEY=not-needed
# Porta interna do container (a plataforma mapeia 8080 -> porta publica).
PORT=8080
